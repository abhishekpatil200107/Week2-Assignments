            "{{employeeId}}"
          ]
        }
      }
    },
    {
      "name": "DELETE - remove employee",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"200 OK\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ],
      "request": {
        "method": "DELETE",
        "header": [],
